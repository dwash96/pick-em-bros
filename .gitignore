# Ignore everything
*

# But descend into directories
!*/

# Recursively allow files under subtree
!/.github/**


# ===================== Keep these tracked =====================
# Root config / docs
!/.gitattributes
!/.gitignore
!/package.json
!/package-lock.json
!/vite.config.js
!/vite-plugin-picks-data.js
!/index.html
!/README.md
!/data-schema.md

# Source code
!/src/**

# Public assets (team logos, favicon)
!/public/**

# The pick data the site is built from (data/{year}/week-{N}.yml)
!/data/**

# Local dev fixtures
!/mock_data/**

# Automation skills/subagents
!/.agent/**


# ===================== Stay ignored =====================
# (these are already covered by the ignore-all above, listed for clarity)
node_modules/
dist/
*.local
.env
.env.*
!.env.example
.cecli/
npm-debug.log*
yarn-*.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
