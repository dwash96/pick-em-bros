# Ignore everything
*

# But descend into directories
!*/

# Recursively allow files under subtree
!/.agent/**
!/.github/**
!/data/**
!/mock_data/**
!/public/**
!/src/**
!/scripts/**

# Specific Files
!/.gitattributes
!/.gitignore
!/package.json
!/package-lock.json
!/vite.config.js
!/vite-plugin-picks-data.js
!/index.html
!/README.md
!/data-schema.md

# Ignore specific files
npm-debug.log*
yarn-*.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*.local
.env
.env.*
!.env.example

# Ignore Folders
node_modules/
dist/
.vscode/
.idea/
.cecli/
